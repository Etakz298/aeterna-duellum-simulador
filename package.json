{
  "name": "simulador-cartas",
  "private": true,
  "version": "0.0.0",
  "description": "Simulador de partidas Aeterna Duellum",
  "author": "Pablo",
  "type": "module",
  "main": "electron-main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "electron:dev": "npm run build && electron .",
    "electron:build": "npm run build && electron-builder",
    "start": "node server/index.js",
    "server": "node server/index.js"
  },
  "dependencies": {
    "lucide-react": "^1.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "utif": "^3.1.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "^34.3.0",
    "electron-builder": "^25.1.8",
    "electron-packager": "^17.1.2",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  },
  "build": {
    "appId": "com.aeternaduellum.cardsim",
    "productName": "Aeterna Duellum - Simulador",
    "win": {
      "target": [
        "portable"
      ]
    },
    "files": [
      "dist/**/*",
      "electron-main.cjs",
      "preload.cjs"
    ],
    "directories": {
      "output": "dist-desktop"
    }
  },
  "engines": {
    "node": "22.x"
  }
}
